   "source": [
    "## 7. Приложение. Полный листинг программного кода\n",
    "\n",
    "Ниже — объединённый самодостаточный скрипт, воспроизводящий все шаги лабораторной работы. Для интерактивного разбора используйте ячейки выше; этот блок предназначен для отчёта и повторного запуска целиком.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# =============================================================================\n",
    "# ПРИЛОЖЕНИЕ: полный листинг кода\n",
    "# Лабораторная работа: Linear / Ridge / Lasso + PCA (penguins)\n",
    "# =============================================================================\n",
    "\n",
    "from __future__ import annotations\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.base import clone\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.linear_model import Lasso, LinearRegression, Ridge\n",
    "from sklearn.metrics import mean_squared_error, r2_score\n",
    "from sklearn.model_selection import GridSearchCV, KFold, train_test_split\n",
    "from sklearn.pipeline import Pipeline\n",
    "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
    "from statsmodels.stats.outliers_influence import variance_inflation_factor\n",
    "\n",
    "RANDOM_STATE = 42\n",
    "TARGET = \"body_mass_g\"\n",
    "NUMERIC_FEATURES = [\"culmen_length_mm\", \"culmen_depth_mm\", \"flipper_length_mm\"]\n",
    "CATEGORICAL_FEATURES = [\"species\", \"island\", \"sex\"]\n",
    "FIGURES_DIR = Path(\"figures\")\n",
    "FIGURES_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ----- 1. Загрузка -----\n",
    "df = pd.read_csv(\"penguins.csv\")  # при необходимости скорректируйте путь\n",
    "\n",
    "# ----- 2. EDA: распределения -----\n",
    "for col in NUMERIC_FEATURES + [TARGET]:\n",
    "    plt.figure(figsize=(7, 5))\n",
    "    plt.hist(df[col].dropna(), bins=25)\n",
    "    plt.xlabel(col)\n",
    "    plt.ylabel(\"Frequency\")\n",
    "    plt.title(f\"Distribution: {col}\")\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(FIGURES_DIR / f\"distribution_{col}.png\", dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "labels = list(df[\"species\"].dropna().unique())\n",
    "groups = [df.loc[df[\"species\"] == s, TARGET].dropna().values for s in labels]\n",
    "plt.boxplot(groups, labels=labels)\n",
    "plt.xlabel(\"Species\")\n",
    "plt.ylabel(TARGET)\n",
    "plt.title(\"Body mass by penguin species\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"body_mass_by_species.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "# ----- 3. Scatter -----\n",
    "for col in NUMERIC_FEATURES:\n",
    "    plt.figure(figsize=(7, 5))\n",
    "    for species in df[\"species\"].dropna().unique():\n",
    "        subset = df[df[\"species\"] == species]\n",
    "        plt.scatter(subset[col], subset[TARGET], label=species, alpha=0.7)\n",
    "    plt.xlabel(col)\n",
    "    plt.ylabel(TARGET)\n",
    "    plt.title(f\"Body mass vs {col}\")\n",
    "    plt.legend()\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(FIGURES_DIR / f\"scatter_body_mass_vs_{col}.png\", dpi=150)\n",
    "    plt.close()\n",
    "\n",
    "# ----- 4. Корреляции -----\n",
    "cols = NUMERIC_FEATURES + [TARGET]\n",
    "corr = df[cols].corr()\n",
    "plt.figure(figsize=(8, 6))\n",
    "plt.imshow(corr.values, aspect=\"auto\")\n",
    "plt.colorbar()\n",
    "plt.xticks(range(len(cols)), cols, rotation=45, ha=\"right\")\n",
    "plt.yticks(range(len(cols)), cols)\n",
    "for i in range(len(cols)):\n",
    "    for j in range(len(cols)):\n",
    "        plt.text(j, i, f\"{corr.iloc[i, j]:.2f}\", ha=\"center\", va=\"center\")\n",
    "plt.title(\"Correlation matrix\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"correlation_matrix.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "# ----- 5. Train / test -----\n",
    "clean_df = df.dropna(subset=[TARGET]).copy()\n",
    "X = clean_df[NUMERIC_FEATURES + CATEGORICAL_FEATURES].copy()\n",
    "y = clean_df[TARGET].copy()\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, random_state=RANDOM_STATE\n",
    ")\n",
    "\n",
    "# ----- 6. Препроцессоры -----\n",
    "def build_model_preprocessor():\n",
    "    numeric_pipe = Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "        (\"scaler\", StandardScaler()),\n",
    "    ])\n",
    "    categorical_pipe = Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "        (\"onehot\", OneHotEncoder(drop=\"first\", handle_unknown=\"ignore\", sparse_output=False)),\n",
    "    ])\n",
    "    return ColumnTransformer(\n",
    "        transformers=[\n",
    "            (\"num\", numeric_pipe, NUMERIC_FEATURES),\n",
    "            (\"cat\", categorical_pipe, CATEGORICAL_FEATURES),\n",
    "        ],\n",
    "        remainder=\"drop\",\n",
    "        sparse_threshold=0,\n",
    "    )\n",
    "\n",
    "def build_pca_preprocessor():\n",
    "    numeric_pipe = Pipeline([(\"imputer\", SimpleImputer(strategy=\"median\"))])\n",
    "    categorical_pipe = Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
    "        (\"onehot\", OneHotEncoder(drop=\"first\", handle_unknown=\"ignore\", sparse_output=False)),\n",
    "    ])\n",
    "    ct = ColumnTransformer(\n",
    "        transformers=[\n",
    "            (\"num\", numeric_pipe, NUMERIC_FEATURES),\n",
    "            (\"cat\", categorical_pipe, CATEGORICAL_FEATURES),\n",
    "        ],\n",
    "        remainder=\"drop\",\n",
    "        sparse_threshold=0,\n",
    "    )\n",
    "    return Pipeline([(\"columns\", ct), (\"scaler\", StandardScaler())])\n",
    "\n",
    "# ----- 7. VIF -----\n",
    "X_train_num = X_train[NUMERIC_FEATURES].copy()\n",
    "imputer = SimpleImputer(strategy=\"median\")\n",
    "X_num = pd.DataFrame(imputer.fit_transform(X_train_num), columns=NUMERIC_FEATURES)\n",
    "vif_df = pd.DataFrame([\n",
    "    {\"Feature\": f, \"VIF\": variance_inflation_factor(X_num.values, i)}\n",
    "    for i, f in enumerate(X_num.columns)\n",
    "])\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.barh(vif_df[\"Feature\"], vif_df[\"VIF\"])\n",
    "plt.xlabel(\"VIF\")\n",
    "plt.title(\"Variance Inflation Factor (VIF)\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"vif.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "# ----- 8. Метрики -----\n",
    "def mape(y_true, y_pred):\n",
    "    y_true, y_pred = np.asarray(y_true), np.asarray(y_pred)\n",
    "    nz = y_true != 0\n",
    "    return float(np.mean(np.abs((y_true[nz] - y_pred[nz]) / y_true[nz])) * 100)\n",
    "\n",
    "def regression_metrics(y_true, y_pred):\n",
    "    return {\n",
    "        \"RMSE\": float(np.sqrt(mean_squared_error(y_true, y_pred))),\n",
    "        \"R2\": float(r2_score(y_true, y_pred)),\n",
    "        \"MAPE_%\": mape(y_true, y_pred),\n",
    "    }\n",
    "\n",
    "cv = KFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "model_specs = {\n",
    "    \"LinearRegression\": (LinearRegression(), {}),\n",
    "    \"Ridge\": (Ridge(), {\"model__alpha\": np.logspace(-3, 3, 13)}),\n",
    "    \"Lasso\": (Lasso(max_iter=100000), {\"model__alpha\": np.logspace(-3, 1, 12)}),\n",
    "}\n",
    "\n",
    "# ----- 9. Модели до PCA -----\n",
    "searches_before, preds_before, rows_before = {}, {}, []\n",
    "for name, (est, params) in model_specs.items():\n",
    "    pipe = Pipeline([\n",
    "        (\"preprocessor\", clone(build_model_preprocessor())),\n",
    "        (\"model\", est),\n",
    "    ])\n",
    "    gs = GridSearchCV(pipe, params, scoring=\"neg_root_mean_squared_error\", cv=cv, n_jobs=-1)\n",
    "    gs.fit(X_train, y_train)\n",
    "    pred = gs.predict(X_test)\n",
    "    searches_before[name] = gs\n",
    "    preds_before[name] = pred\n",
    "    m = regression_metrics(y_test, pred)\n",
    "    rows_before.append({\n",
    "        \"Model\": name, **m,\n",
    "        \"Best_CV_RMSE\": float(-gs.best_score_),\n",
    "        \"Best_Params\": str(gs.best_params_),\n",
    "    })\n",
    "before_results = pd.DataFrame(rows_before)\n",
    "\n",
    "# ----- 10. Остатки до PCA -----\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))\n",
    "for ax, (name, pred) in zip(axes, preds_before.items()):\n",
    "    res = y_test.values - pred\n",
    "    ax.scatter(pred, res, alpha=0.6, s=20)\n",
    "    ax.axhline(0, color=\"red\", linestyle=\"--\")\n",
    "    ax.set_xlabel(\"Predicted\")\n",
    "    ax.set_ylabel(\"Residuals\")\n",
    "    ax.set_title(name)\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"residuals_before_pca.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "# ----- 11. Модели после PCA -----\n",
    "searches_after, preds_after, rows_after = {}, {}, []\n",
    "for name, (est, params) in model_specs.items():\n",
    "    pipe = Pipeline([\n",
    "        (\"preprocessor\", build_pca_preprocessor()),\n",
    "        (\"pca\", PCA(n_components=0.95)),\n",
    "        (\"model\", est),\n",
    "    ])\n",
    "    gs = GridSearchCV(pipe, params, scoring=\"neg_root_mean_squared_error\", cv=cv, n_jobs=-1)\n",
    "    gs.fit(X_train, y_train)\n",
    "    pred = gs.predict(X_test)\n",
    "    pca = gs.best_estimator_.named_steps[\"pca\"]\n",
    "    searches_after[name] = gs\n",
    "    preds_after[name] = pred\n",
    "    m = regression_metrics(y_test, pred)\n",
    "    rows_after.append({\n",
    "        \"Model\": name, **m,\n",
    "        \"Best_CV_RMSE\": float(-gs.best_score_),\n",
    "        \"PCA_components\": int(pca.n_components_),\n",
    "        \"PCA_explained_variance\": float(pca.explained_variance_ratio_.sum()),\n",
    "        \"Best_Params\": str(gs.best_params_),\n",
    "    })\n",
    "after_results = pd.DataFrame(rows_after)\n",
    "\n",
    "# ----- 12. Scree / cumulative -----\n",
    "fitted_pca = searches_after[\"LinearRegression\"].best_estimator_.named_steps[\"pca\"]\n",
    "ratios = fitted_pca.explained_variance_ratio_\n",
    "cumulative = ratios.cumsum()\n",
    "components = list(range(1, len(ratios) + 1))\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(components, ratios, marker=\"o\")\n",
    "plt.xlabel(\"Principal component\")\n",
    "plt.ylabel(\"Explained variance ratio\")\n",
    "plt.title(\"Scree plot\")\n",
    "plt.xticks(components)\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"scree_plot.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "plt.plot(components, cumulative, marker=\"o\")\n",
    "plt.axhline(0.95, linestyle=\"--\", label=\"95% variance\")\n",
    "plt.xlabel(\"Number of components\")\n",
    "plt.ylabel(\"Cumulative explained variance\")\n",
    "plt.title(\"Cumulative explained variance\")\n",
    "plt.xticks(components)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"cumulative_explained_variance.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "# ----- 13. Остатки после PCA -----\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4.5))\n",
    "for ax, (name, pred) in zip(axes, preds_after.items()):\n",
    "    res = y_test.values - pred\n",
    "    ax.scatter(pred, res, alpha=0.6, s=20)\n",
    "    ax.axhline(0, color=\"red\", linestyle=\"--\")\n",
    "    ax.set_xlabel(\"Predicted\")\n",
    "    ax.set_ylabel(\"Residuals\")\n",
    "    ax.set_title(name)\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"residuals_after_pca.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "# ----- 14. Сравнение RMSE / R2 -----\n",
    "models = list(before_results[\"Model\"])\n",
    "x = list(range(len(models)))\n",
    "width = 0.35\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.bar([i - width / 2 for i in x], before_results[\"RMSE\"], width=width, label=\"Before PCA\")\n",
    "plt.bar([i + width / 2 for i in x], after_results[\"RMSE\"], width=width, label=\"After PCA\")\n",
    "plt.xticks(x, models)\n",
    "plt.ylabel(\"RMSE\")\n",
    "plt.title(\"RMSE comparison before and after PCA\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"rmse_before_after_pca.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.bar([i - width / 2 for i in x], before_results[\"R2\"], width=width, label=\"Before PCA\")\n",
    "plt.bar([i + width / 2 for i in x], after_results[\"R2\"], width=width, label=\"After PCA\")\n",
    "plt.xticks(x, models)\n",
    "plt.ylabel(\"R²\")\n",
    "plt.title(\"R² comparison before and after PCA\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(FIGURES_DIR / \"r2_before_after_pca.png\", dpi=150)\n",
    "plt.close()\n",
    "\n",
    "print(\"Results BEFORE PCA:\")\n",
    "print(before_results.round(4))\n",
    "print(\"\\nResults AFTER PCA:\")\n",
    "print(after_results.round(4))\n",
    "print(\"\\nDone. Figures saved to:\", FIGURES_DIR.resolve())\n",
    "# =============================================================================\n",
    "# Конец листинга\n",
    "# =============================================================================\n"
   ]
  },
